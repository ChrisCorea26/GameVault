<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 desktop app: unpackaged, Windows App SDK self-contained (SPEC §2, §9.1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>GameVault.App</RootNamespace>
    <AssemblyName>GameVault</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Pick the RID from the platform; AnyCPU (or anything unknown) falls back to x64. -->
    <_GameVaultArch>$(Platform.ToLowerInvariant())</_GameVaultArch>
    <_GameVaultArch Condition="'$(_GameVaultArch)' != 'x86' and '$(_GameVaultArch)' != 'arm64'">x64</_GameVaultArch>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(_GameVaultArch)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- LibraryImport (SendInput for pad navigation) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- The game database (SPEC §7.5) ships next to the executable. -->
  <ItemGroup>
    <Content Include="..\..\data\gamedb\**\*.json" Link="data\gamedb\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
    <ProjectReference Include="..\GameVault.Library\GameVault.Library.csproj" />
    <ProjectReference Include="..\GameVault.Platform\GameVault.Platform.csproj" />
    <ProjectReference Include="..\GameVault.ViewModels\GameVault.ViewModels.csproj" />
  </ItemGroup>

</Project>
