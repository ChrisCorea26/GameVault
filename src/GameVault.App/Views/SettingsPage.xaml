<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameVault.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GameVault.ViewModels"
    mc:Ignorable="d">

  <ScrollViewer>
    <StackPanel MaxWidth="760" Padding="32,16,32,32" HorizontalAlignment="Left" Spacing="8">
      <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

      <!-- Family (SPEC §7.9): profiles, daily limits and the parent PIN -->
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.Family.SettingsLocked, Mode=OneWay, FallbackValue=False}"
          Message="A parent can unlock Settings with the PIN below."
          Severity="Informational"
          Title="Settings are locked for this profile" />
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Family" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="12">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Each person gets their own library, saves and settings. A daily limit saves and pauses the game when time's up; a parent's PIN lets them keep going."
              TextWrapping="Wrap" />
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Family.Profiles, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:FamilyProfileItem">
                <Grid Padding="0,4" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon FontSize="20" Glyph="{x:Bind Icon}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Details}" />
                  </StackPanel>
                  <Button Grid.Column="2" Command="{x:Bind RemoveCommand}" Content="Remove" IsEnabled="{x:Bind CanRemove}" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>

          <!-- The PIN unlocks profile changes (and Settings for a locked profile). -->
          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Family.ManageLocked, Mode=OneWay, FallbackValue=Collapsed}">
            <PasswordBox
                Width="160"
                AutomationProperties.Name="Parent PIN"
                InputScope="NumericPin"
                Password="{x:Bind ViewModel.Family.PinEntry, Mode=TwoWay}"
                PlaceholderText="Parent PIN" />
            <Button Command="{x:Bind ViewModel.Family.UnlockCommand}" Content="Unlock" />
          </StackPanel>

          <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Family.CanManage, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Header="New profile" PlaceholderText="Name" Text="{x:Bind ViewModel.Family.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBox
                  Grid.Column="1"
                  Header="Minutes a day"
                  InputScope="Number"
                  PlaceholderText="No limit"
                  Text="{x:Bind ViewModel.Family.NewLimitMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.Family.AddProfileCommand}" Content="Add" />
            </Grid>
            <CheckBox Content="Can change settings" IsChecked="{x:Bind ViewModel.Family.NewCanChangeSettings, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PasswordBox
                  Width="160"
                  AutomationProperties.Name="New parent PIN"
                  InputScope="NumericPin"
                  Password="{x:Bind ViewModel.Family.NewPin, Mode=TwoWay}"
                  PlaceholderText="4 to 12 digits" />
              <Button Command="{x:Bind ViewModel.Family.SetPinCommand}" Content="Set parent PIN" />
              <Button Command="{x:Bind ViewModel.Family.RemovePinCommand}" Content="Remove PIN" Visibility="{x:Bind ViewModel.Family.HasPin, Mode=OneWay, FallbackValue=Collapsed}" />
              <Button Command="{x:Bind ViewModel.Family.LockCommand}" Content="Lock" Visibility="{x:Bind ViewModel.Family.IsUnlocked, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{x:Bind ViewModel.Family.Message, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Everything below is off for a locked profile until a parent unlocks it. -->
      <ContentControl
          HorizontalContentAlignment="Stretch"
          IsEnabled="{x:Bind ViewModel.Family.CanChangeSettings, Mode=OneWay, FallbackValue=True}"
          IsTabStop="False">
        <StackPanel Spacing="8">

      <!-- RetroAchievements (SPEC §7.10) -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="RetroAchievements" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="12">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Earn achievements and compete on leaderboards with your RetroAchievements.org account. Your password is only sent to RetroAchievements; GameVault keeps an encrypted sign-in token instead."
              TextWrapping="Wrap" />
          <TextBlock
              Text="The RetroAchievements component is missing from this copy of GameVault."
              TextWrapping="Wrap"
              Visibility="{x:Bind ViewModel.RetroAchievements.IsUnavailable, Mode=OneWay, FallbackValue=Collapsed}" />
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RetroAchievements.IsSignedOut, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBox
                Width="280"
                HorizontalAlignment="Left"
                Header="Username"
                Text="{x:Bind ViewModel.RetroAchievements.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                Width="280"
                HorizontalAlignment="Left"
                Header="Password"
                Password="{x:Bind ViewModel.RetroAchievements.Password, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{x:Bind ViewModel.RetroAchievements.SignInCommand}" Content="Sign in" Style="{StaticResource AccentButtonStyle}" />
              <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.RetroAchievements.IsBusy, Mode=OneWay, FallbackValue=False}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.RetroAchievements.IsSignedIn, Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.RetroAchievements.SignedInText, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.RetroAchievements.SignOutCommand}" Content="Sign out" />
          </StackPanel>
          <Grid Visibility="{x:Bind ViewModel.RetroAchievements.IsAvailable, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Hardcore mode" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Achievements count double on RetroAchievements. Loading save states, rewind, codes, slow motion and netplay are off; saving states still works. Turning it on restarts the running game."
                  TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                IsOn="{x:Bind ViewModel.RetroAchievements.Hardcore, Mode=TwoWay, FallbackValue=False}"
                OffContent=""
                OnContent="" />
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.RetroAchievements.Message, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Library (SPEC §6.2) -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Library" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Game folders" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="GameVault looks in these folders for games for every system it plays (NES and Disk System, SG-1000, Master System, Apple II, Genesis, Super Nintendo, PlayStation, Nintendo 64 and PlayStation 2), including games inside .zip files, and notices when you add or remove them."
              TextWrapping="Wrap" />
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Library.Folders}">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryFolderViewModel">
                <Grid Padding="0,4" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Command="{x:Bind RemoveCommand}" Content="Remove" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Text="No folders yet."
              Visibility="{x:Bind ViewModel.Library.HasNoFolders, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.Library.AddFolderCommand}" Content="Add a folder…" />
            <Button Command="{x:Bind ViewModel.Library.RescanCommand}" Content="Look for new games" />
            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.Library.IsScanning, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Library.Status, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Video -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Video" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Hide screen edges" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Crops the top and bottom of the picture, like most TVs did. Some games draw flickering lines or garbage at the edges; hide more to cover them."
                TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox
              Grid.Column="1"
              MinWidth="220"
              VerticalAlignment="Center"
              AutomationProperties.Name="Hide screen edges"
              ItemsSource="{x:Bind ViewModel.OverscanOptions}"
              SelectedIndex="{x:Bind ViewModel.OverscanIndex, Mode=TwoWay}" />
        </Grid>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Picture style" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Changes apply the next time a game starts."
              TextWrapping="Wrap" />
          <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DisplayPresetIndex, Mode=TwoWay}">
            <x:String>Sharp pixels</x:String>
            <x:String>Smooth</x:String>
            <x:String>Living room CRT</x:String>
            <x:String>Arcade monitor</x:String>
          </RadioButtons>
        </StackPanel>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="TV pixel shape" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Makes the picture a little wider, the way it looked on a TV."
                TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Column="1"
              MinWidth="0"
              IsOn="{x:Bind ViewModel.TvPixelShape, Mode=TwoWay}"
              OffContent=""
              OnContent="" />
        </Grid>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Play in full screen" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Games start filling the screen. While playing, F11 or Alt+Enter switches, and Esc leaves full screen."
                TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Column="1"
              MinWidth="0"
              AutomationProperties.Name="Play in full screen"
              IsOn="{x:Bind ViewModel.PlayFullScreen, Mode=TwoWay}"
              OffContent=""
              OnContent="" />
        </Grid>
      </Border>

      <!-- Audio -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Audio" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Game volume" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Takes effect the next time you start a game."
                TextWrapping="Wrap" />
          </StackPanel>
          <Slider
              Grid.Column="1"
              VerticalAlignment="Center"
              AutomationProperties.Name="Game volume"
              Maximum="100"
              Minimum="0"
              StepFrequency="5"
              Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
        </Grid>
      </Border>

      <!-- Gameplay -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Gameplay" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock Text="Reduce input lag" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Makes controls feel more responsive. Higher settings need a faster PC. Always off for PlayStation 2 games, which are too large to replay every frame."
              TextWrapping="Wrap" />
          <RadioButtons MaxColumns="4" SelectedIndex="{x:Bind ViewModel.RunAheadFrames, Mode=TwoWay}">
            <x:String>Off</x:String>
            <x:String>Low</x:String>
            <x:String>Medium</x:String>
            <x:String>High</x:String>
          </RadioButtons>
        </StackPanel>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Pause when GameVault is in the background" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="The game pauses when you switch to another window."
                TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Column="1"
              MinWidth="0"
              IsOn="{x:Bind ViewModel.PauseWhenInactive, Mode=TwoWay}"
              OffContent=""
              OnContent="" />
        </Grid>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Rewind memory" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Hold Backspace or the left shoulder button to rewind. More memory keeps a longer history. PlayStation 2 games rewind in half-second steps. Takes effect the next time you start a game."
                TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox
              Grid.Column="1"
              VerticalAlignment="Center"
              AutomationProperties.Name="Rewind memory"
              ItemsSource="{x:Bind ViewModel.RewindMemoryOptions}"
              SelectedIndex="{x:Bind ViewModel.RewindMemoryIndex, Mode=TwoWay}" />
        </Grid>
      </Border>

      <!-- Input (docs/design/input.md §9) -->
      <Grid Margin="0,16,0,4">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Controllers" />
        <Button
            HorizontalAlignment="Right"
            Command="{x:Bind ViewModel.Input.SwapPlayersCommand}"
            Content="Swap players" />
      </Grid>
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Input.Ports}">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinColumnSpacing="8" MinItemWidth="300" MinRowSpacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:InputPortViewModel">
            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                <ItemsRepeater ItemsSource="{x:Bind Sources}">
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:InputSourceViewModel">
                      <Grid Padding="0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" />
                        <HyperlinkButton
                            Grid.Column="2"
                            Command="{x:Bind TogglePinCommand}"
                            Content="{x:Bind PinLabel}"
                            Visibility="{x:Bind CanPin}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind WaitingText}"
                    Visibility="{x:Bind IsWaiting}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="No controller. Connect one, or pick one below."
                    Visibility="{x:Bind HasNoSources}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>

      <Border
          Padding="16"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Visibility="{x:Bind ViewModel.Input.HasUnassigned, Mode=OneWay}">
        <StackPanel Spacing="8">
          <TextBlock Text="Other controllers" />
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Input.Unassigned}">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:UnassignedControllerViewModel">
                <Grid Padding="0,4" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                  <Button Grid.Column="1" Command="{x:Bind UseForPlayer1Command}" Content="Use for Player 1" />
                  <Button Grid.Column="2" Command="{x:Bind UseForPlayer2Command}" Content="Use for Player 2" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
      </Border>

      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Two players, one keyboard" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Player 1 uses the arrows with comma and period; Player 2 uses W A S D with F and G. Some keyboards can't register many keys at once and may drop presses."
                TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Column="1"
              MinWidth="0"
              IsOn="{x:Bind ViewModel.Input.TwoPlayerKeyboard, Mode=TwoWay}"
              OffContent=""
              OnContent="" />
        </Grid>
      </Border>

      <!-- Turbo speed (input.md §6): pads' West/North buttons and the keyboard's A/S turbo keys -->
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Turbo speed" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="How fast turbo buttons repeat while held. On the keyboard, A is turbo B and S is turbo A; on a controller, the left and top face buttons."
                TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox
              Grid.Column="1"
              MinWidth="220"
              VerticalAlignment="Center"
              AutomationProperties.Name="Turbo speed"
              ItemsSource="{x:Bind ViewModel.Input.TurboSpeedOptions}"
              SelectedIndex="{x:Bind ViewModel.Input.TurboSpeedIndex, Mode=TwoWay}" />
        </Grid>
      </Border>

      <!-- Cartridge dumper (SPEC §8) -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Cartridge dumper" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Optional. To dump your own cartridges with an INL Retro-Prog, paste where its program (inlretro.exe) is. Takes effect the next time GameVault starts."
              TextWrapping="Wrap" />
          <TextBox
              AutomationProperties.Name="INL Retro-Prog program"
              LostFocus="DumperPath_LostFocus"
              PlaceholderText="C:\INL-retro\inlretro.exe"
              Text="{x:Bind ViewModel.DumperPath, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <!-- SPEC §7.8: code collections the player imports; they stay on this PC and are never part of GameVault -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Codes" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Import a list of Game Genie codes you have, as a spreadsheet (.xlsx) or .csv with Game, Code (or Key in…) and Effect columns. Each game's matching codes then appear under Codes on its details and in the Player. The list stays on this PC."
              TextWrapping="Wrap" />
          <ItemsRepeater ItemsSource="{x:Bind Codes.Items}">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:CodeCollectionItemViewModel">
                <Grid Padding="0,4" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{x:Bind Name}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Summary}" />
                  </StackPanel>
                  <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind RemoveCommand}" Content="Remove" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
          <Button Command="{x:Bind Codes.ImportCommand}" Content="Import a code collection…" />
          <TextBlock Text="{x:Bind Codes.Message, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Famicom Disk System (SPEC §4.5): the player's own BIOS; GameVault never ships it -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Disk System" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Famicom Disk System games (.fds) need the Disk System BIOS (disksys.rom, 8 KB) from your own console. GameVault doesn't include it. Paste where the file is."
              TextWrapping="Wrap" />
          <TextBox
              AutomationProperties.Name="Disk System BIOS file"
              LostFocus="FdsBiosPath_LostFocus"
              PlaceholderText="C:\NES\disksys.rom"
              Text="{x:Bind ViewModel.FdsBiosPath, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <!-- Apple II (SPEC §7.11): the player's own ROMs; GameVault never ships them -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Apple II" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Apple II disks (.dsk, .do, .po, .nib, .woz) need the ROMs from your own Apple: the system ROM (12 KB for a II or II+, 16 KB for a IIe) and the Disk II controller's 256-byte boot ROM. GameVault doesn't include them. Paste where the files are."
              TextWrapping="Wrap" />
          <TextBox
              AutomationProperties.Name="Apple II system ROM file"
              Header="System ROM"
              LostFocus="AppleRoms_LostFocus"
              PlaceholderText="C:\Apple\apple2e-enhanced.rom"
              Text="{x:Bind ViewModel.AppleIIRomPath, Mode=TwoWay}" />
          <TextBox
              AutomationProperties.Name="Disk II boot ROM file"
              Header="Disk II boot ROM"
              LostFocus="AppleRoms_LostFocus"
              PlaceholderText="C:\Apple\disk2.rom"
              Text="{x:Bind ViewModel.AppleIIDiskRomPath, Mode=TwoWay}" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="While an Apple II game runs, the keyboard types into it. F1 is the Apple's Esc key, Backspace is its left arrow, Shift+Backspace rewinds, and Ctrl+F12 is Reset."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- PlayStation (SPEC §7.11): the player's own BIOS; GameVault never ships it -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="PlayStation" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="PlayStation discs (.cue with its .bin files, .chd, .iso, or an .m3u list of discs) need the BIOS from your own console (512 KB, such as SCPH-1001). GameVault doesn't include it. Paste where the file is."
              TextWrapping="Wrap" />
          <TextBox
              AutomationProperties.Name="PlayStation BIOS file"
              LostFocus="PlayStationBiosPath_LostFocus"
              PlaceholderText="C:\PlayStation\scph1001.bin"
              Text="{x:Bind ViewModel.PlayStationBiosPath, Mode=TwoWay}" />
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Skip the startup screens" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Starts the game straight away instead of showing the console's intro. A few games need the intro to start correctly."
                  TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                AutomationProperties.Name="Skip the PlayStation startup screens"
                IsOn="{x:Bind ViewModel.PlayStationFastBoot, Mode=TwoWay}"
                OffContent=""
                OnContent="" />
          </Grid>
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Each game gets its own memory card in slot 1, saved with your other game saves."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Nintendo 64 (SPEC §7.11, Phase 16) -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nintendo 64" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Expansion Pak" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Gives games the extra memory of the Expansion Pak. Most games and homebrew are happy with it on; turn it off for the rare game that won't start with it. Takes effect the next time a game starts."
                  TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                AutomationProperties.Name="Nintendo 64 Expansion Pak"
                IsOn="{x:Bind ViewModel.N64ExpansionPak, Mode=TwoWay}"
                OffContent=""
                OnContent="" />
          </Grid>
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="N64 games play from .z64, .v64 and .n64 files. Each game gets its own Controller Pak, saved with your other game saves."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- PlayStation 2 (SPEC §7.11, Phase 17): the player's own BIOS; GameVault never ships it -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="PlayStation 2" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <StackPanel Spacing="8">
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="PlayStation 2 discs (.iso, .chd, or .cue with its .bin files) need the BIOS from your own console (4 MB, such as SCPH-39001). GameVault doesn't include it. Homebrew .elf programs run without it. Paste where the file is."
              TextWrapping="Wrap" />
          <TextBox
              AutomationProperties.Name="PlayStation 2 BIOS file"
              LostFocus="PlayStation2BiosPath_LostFocus"
              PlaceholderText="C:\PlayStation 2\scph39001.bin"
              Text="{x:Bind ViewModel.PlayStation2BiosPath, Mode=TwoWay}" />
          <InfoBar
              IsClosable="False"
              IsOpen="{x:Bind ViewModel.HasPlayStation2BiosProblem, Mode=OneWay}"
              Message="{x:Bind ViewModel.PlayStation2BiosProblem, Mode=OneWay}"
              Severity="Warning" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="{x:Bind ViewModel.PlayStation2BiosStatus, Mode=OneWay}"
              TextWrapping="Wrap" />
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Skip the startup screens" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Starts the game straight away instead of showing the console's startup screens and browser. A few games need them to start correctly."
                  TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                MinWidth="0"
                AutomationProperties.Name="Skip the PlayStation 2 startup screens"
                IsOn="{x:Bind ViewModel.PlayStation2FastBoot, Mode=TwoWay}"
                OffContent=""
                OnContent="" />
          </Grid>
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="Each game gets its own 8 MB memory card in slot 1, saved with your other game saves."
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Advanced -->
      <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Advanced" />
      <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Allow opposite directions" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Lets a game see Left and Right (or Up and Down) held at once. A real controller can't do this, and some games glitch. Takes effect the next time you start a game."
                TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch
              Grid.Column="1"
              MinWidth="0"
              IsOn="{x:Bind ViewModel.AllowOppositeDirections, Mode=TwoWay}"
              OffContent=""
              OnContent="" />
        </Grid>
      </Border>

      <Button
          Margin="0,16,0,0"
          Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
          Content="Restore defaults" />
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</Page>
