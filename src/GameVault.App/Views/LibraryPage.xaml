<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameVault.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GameVault.ViewModels"
    mc:Ignorable="d">

  <Page.Resources>
    <!-- Grid tile: placeholder cover (initials) until the user adds their own artwork, then title and badges. -->
    <DataTemplate x:Key="GameTileTemplate" x:DataType="vm:GameTileViewModel">
      <Grid Width="{StaticResource TileWidth}" RowSpacing="6" Padding="0,0,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="{StaticResource TileCoverHeight}"
            Background="{ThemeResource AccentFillColorSecondaryBrush}"
            CornerRadius="{StaticResource OverlayCornerRadius}">
          <Grid>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="48"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                Text="{x:Bind Initials}" />
            <FontIcon
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="16"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                Glyph="&#xE735;"
                Visibility="{x:Bind IsFavorite}"
                AutomationProperties.Name="Favorite" />
          </Grid>
        </Border>

        <TextBlock
            Grid.Row="1"
            Padding="4,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Title}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Grid.Row="2"
            Padding="4,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind Subtitle}"
            TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="3" Padding="4,0" Orientation="Horizontal" Spacing="6">
          <Border
              Padding="6,1"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              CornerRadius="4">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusText}" />
          </Border>
          <Border
              Padding="6,1"
              Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
              CornerRadius="4"
              Visibility="{x:Bind IsOwned}">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Owned" />
          </Border>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- List row: compact version of the tile with playtime. -->
    <DataTemplate x:Key="GameRowTemplate" x:DataType="vm:GameTileViewModel">
      <Grid Padding="0,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <Border
            Width="40"
            Height="40"
            Background="{ThemeResource AccentFillColorSecondaryBrush}"
            CornerRadius="4">
          <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontWeight="SemiBold"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Text="{x:Bind Initials}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
          <TextBlock
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Style="{StaticResource CaptionTextBlockStyle}"
              Text="{x:Bind Subtitle}" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
          <FontIcon FontSize="14" Glyph="&#xE735;" Visibility="{x:Bind IsFavorite}" AutomationProperties.Name="Favorite" />
          <Border Padding="6,1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusText}" />
          </Border>
          <Border
              Padding="6,1"
              Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
              CornerRadius="4"
              Visibility="{x:Bind IsOwned}">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Owned" />
          </Border>
        </StackPanel>

        <TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            HorizontalTextAlignment="Right"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind PlaytimeText}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="32,16,32,0" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header and collection completion summary -->
    <StackPanel Grid.Row="0" Spacing="8">
      <Grid>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" />
        <Button
            HorizontalAlignment="Right"
            AccessKey="O"
            Command="{x:Bind ViewModel.OpenGameFileCommand}"
            Style="{StaticResource AccentButtonStyle}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE8E5;" />
            <TextBlock Text="Open game file" />
          </StackPanel>
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar
            Width="200"
            VerticalAlignment="Center"
            Maximum="1"
            Value="{x:Bind ViewModel.CompletionFraction, Mode=OneWay}" />
        <TextBlock
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>

    <!-- Search, filters and view toggle -->
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <AutoSuggestBox
          Grid.Column="0"
          AccessKey="S"
          PlaceholderText="Search by title, publisher or genre"
          QueryIcon="Find"
          Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ToggleSwitch
          Grid.Column="1"
          IsOn="{x:Bind ViewModel.ShowOwnedOnly, Mode=TwoWay}"
          OffContent="All games"
          OnContent="Owned only" />
      <AppBarToggleButton
          Grid.Column="3"
          AccessKey="V"
          Command="{x:Bind ViewModel.ToggleViewCommand}"
          IsChecked="{x:Bind ViewModel.IsListView, Mode=OneWay}"
          Label="List view"
          LabelPosition="Collapsed"
          ToolTipService.ToolTip="Switch between grid and list">
        <AppBarToggleButton.Icon>
          <FontIcon Glyph="&#xE8FD;" />
        </AppBarToggleButton.Icon>
      </AppBarToggleButton>
    </Grid>

    <!-- Content: grid or list, plus loading, empty and no-match states -->
    <Grid Grid.Row="2">
      <GridView
          IsItemClickEnabled="True"
          ItemClick="Games_ItemClick"
          ItemTemplate="{StaticResource GameTileTemplate}"
          ItemsSource="{x:Bind ViewModel.Games}"
          SelectionMode="None"
          Visibility="{x:Bind ViewModel.IsGridView, Mode=OneWay}"
          XYFocusKeyboardNavigation="Enabled" />

      <ListView
          IsItemClickEnabled="True"
          ItemClick="Games_ItemClick"
          ItemTemplate="{StaticResource GameRowTemplate}"
          ItemsSource="{x:Bind ViewModel.Games}"
          SelectionMode="None"
          Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}"
          XYFocusKeyboardNavigation="Enabled" />

      <ProgressRing
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

      <StackPanel
          MaxWidth="480"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="{x:Bind ViewModel.IsEmptyLibrary, Mode=OneWay}">
        <FontIcon FontSize="48" Glyph="&#xE7FC;" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Your library is empty" />
        <TextBlock
            HorizontalTextAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="GameVault plays games you supply yourself, such as dumps of cartridges you own. Use Open game file to play one now; adding whole folders is coming in a later update."
            TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="No games match your search."
          Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />
    </Grid>
  </Grid>
</Page>
