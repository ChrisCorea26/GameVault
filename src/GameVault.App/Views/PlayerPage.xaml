<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameVault.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameVault.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:GameVault.App.Helpers"
    xmlns:svc="using:GameVault.ViewModels.Services"
    xmlns:vm="using:GameVault.ViewModels"
    mc:Ignorable="d">

  <Page.KeyboardAccelerators>
    <!-- Esc leaves full screen, otherwise pauses; F11 and Alt+Enter switch full screen (docs/design/input.md §8). -->
    <KeyboardAccelerator Key="Escape" Invoked="Pause_Invoked" />
    <KeyboardAccelerator Key="F11" Invoked="FullScreen_Invoked" />
    <KeyboardAccelerator Key="Enter" Invoked="FullScreen_Invoked" Modifiers="Menu" />
  </Page.KeyboardAccelerators>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top bar (hidden in full screen) -->
    <Grid Grid.Row="0" Padding="12,4" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsWindowed, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button
          Grid.Column="0"
          AccessKey="B"
          AutomationProperties.Name="Back to library"
          Command="{x:Bind ViewModel.BackCommand}"
          Style="{StaticResource NavigationBackButtonNormalStyle}"
          ToolTipService.ToolTip="Back to library" />
      <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Style="{StaticResource SubtitleTextBlockStyle}"
          Text="{x:Bind ViewModel.Title, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
      <!-- Clicking these leaves keyboard focus on the game, so the controls keep working (input.md §4.4). -->
      <Button
          Grid.Column="3"
          AccessKey="P"
          AllowFocusOnInteraction="False"
          Command="{x:Bind ViewModel.TogglePauseCommand}"
          Content="{x:Bind ViewModel.PauseButtonLabel, Mode=OneWay}" />
      <Button
          Grid.Column="4"
          AccessKey="R"
          AllowFocusOnInteraction="False"
          Command="{x:Bind ViewModel.ResetCommand}"
          Content="Reset" />
      <!-- SPEC §7.8: codes for this game; the badge shows while any are on. F3 turns them all off. -->
      <Button Grid.Column="9" AccessKey="C" AutomationProperties.Name="Codes">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Codes" />
          <Border
              Padding="6,0"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              CornerRadius="8"
              Visibility="{x:Bind ViewModel.Codes.AnyEnabled, Mode=OneWay}">
            <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="on" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <controls:CodesPanel Width="460" ViewModel="{x:Bind ViewModel.Codes}" />
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.7: two-player netplay on the local network (LAN-only for now) -->
      <Button Grid.Column="10" AccessKey="N" Content="Netplay">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="340" Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.Netplay.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Netplay.HasInviteCode, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="28"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Netplay.InviteCode, Mode=OneWay}" />
                <Button HorizontalAlignment="Center" Command="{x:Bind ViewModel.Netplay.CopyCodeCommand}" Content="Copy code" />
              </StackPanel>
              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Netplay.IsIdle, Mode=OneWay}">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.Netplay.HostCommand}"
                    Content="Host a game on this network"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Or join with the other player's code:" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox
                      AutomationProperties.Name="Invite code"
                      FontFamily="Consolas"
                      PlaceholderText="ABCDE-12345"
                      Text="{x:Bind ViewModel.Netplay.JoinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{x:Bind ViewModel.Netplay.JoinCommand}" Content="Join" />
                </Grid>
              </StackPanel>
              <Button
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.Netplay.LeaveCommand}"
                  Content="Leave netplay"
                  Visibility="{x:Bind ViewModel.Netplay.IsActive, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.Netplay.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Both games start over from the title screen, without save files or codes. Windows may ask to let GameVault use the network the first time."
                  TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <ToggleButton
          Grid.Column="12"
          AccessKey="T"
          AllowFocusOnInteraction="False"
          Content="Stats"
          IsChecked="{x:Bind ViewModel.ShowStats, Mode=TwoWay}"
          ToolTipService.ToolTip="Show values from the game, such as exact health"
          Visibility="{x:Bind ViewModel.HasMemoryMap, Mode=OneWay}" />
      <Button
          Grid.Column="11"
          AccessKey="F"
          AllowFocusOnInteraction="False"
          AutomationProperties.Name="{x:Bind ViewModel.FullScreenButtonLabel, Mode=OneWay}"
          Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
          ToolTipService.ToolTip="Full screen (F11 or Alt+Enter; Esc to leave)">
        <FontIcon FontSize="16" Glyph="&#xE740;" />
      </Button>

      <!-- Famicom Disk System: the side in the drive; F4 inserts the next side (input.md §8) -->
      <ComboBox
          Grid.Column="8"
          MinWidth="170"
          VerticalAlignment="Center"
          AutomationProperties.Name="Disk side"
          DropDownClosed="DiskSide_DropDownClosed"
          ItemsSource="{x:Bind ViewModel.DiskSlots}"
          SelectedIndex="{x:Bind ViewModel.DiskSlotIndex, Mode=TwoWay}"
          ToolTipService.ToolTip="Disk side (F4: next side)"
          Visibility="{x:Bind ViewModel.IsDiskSystem, Mode=OneWay}" />
      <!-- SPEC §7.1: the save-state timeline; F5 saves, F8 loads the newest (docs/design/input.md §8). -->
      <Button Grid.Column="5" AccessKey="S" Content="Save states">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="620" Spacing="8">
              <Grid>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save states" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.Timeline.SaveCommand}" Content="Save now" Style="{StaticResource AccentButtonStyle}" />
              </Grid>
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="F5 saves and F8 loads the newest. Right-click a state to pin or delete it." />
              <controls:TimelineStrip ItemTemplate="{StaticResource TimelineItemTemplate}" ItemsSource="{x:Bind ViewModel.Timeline.Items}" />
              <InfoBar
                  IsClosable="True"
                  IsOpen="{x:Bind ViewModel.Timeline.HasUndo, Mode=OneWay}"
                  Message="{x:Bind ViewModel.Timeline.UndoText, Mode=OneWay}"
                  Severity="Informational">
                <InfoBar.ActionButton>
                  <Button Command="{x:Bind ViewModel.Timeline.UndoCommand}" Content="Undo" />
                </InfoBar.ActionButton>
              </InfoBar>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.6: Assist mode, per session, never forced -->
      <Button Grid.Column="6" AccessKey="A" Content="Assist">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="300" Spacing="8">
              <ToggleSwitch Header="Assist mode" IsOn="{x:Bind ViewModel.Assist.IsEnabled, Mode=TwoWay}" />
              <ComboBox
                  Header="Speed"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Assist.SpeedOptions}"
                  SelectedIndex="{x:Bind ViewModel.Assist.SpeedIndex, Mode=TwoWay}" />
              <ComboBox
                  Header="Colors"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Assist.PaletteOptions}"
                  SelectedIndex="{x:Bind ViewModel.Assist.PaletteIndex, Mode=TwoWay}" />
              <CheckBox Content="Unlimited rewind" IsChecked="{x:Bind ViewModel.Assist.UnlimitedRewind, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}" />
              <CheckBox Content="Reduce flicker" IsChecked="{x:Bind ViewModel.Assist.RemoveFlicker, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.6: Practice mode -->
      <Button Grid.Column="7" Content="Practice">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="300" Spacing="8">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Practice" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Set a practice point, then press F6 to retry from it and F7 to mark a split."
                  TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.Practice.SetPointCommand}" Content="Set practice point" />
                <Button Command="{x:Bind ViewModel.Practice.RetryCommand}" Content="Retry" />
                <Button Command="{x:Bind ViewModel.Practice.SplitCommand}" Content="Split" />
              </StackPanel>
              <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Practice.CurrentTime, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Practice.BestForCurrent, Mode=OneWay}" />
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.Practice.Segments}">
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:SegmentViewModel">
                    <Grid Padding="0,2" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Title}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Time}" />
                      <TextBlock Grid.Column="2" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind Badge}" />
                    </Grid>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="12,0,12,0" Spacing="8">
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
          Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
          Severity="Error"
          Title="Can't play this game" />
      <!-- docs/design/input.md §5 -->
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.HasControllerMessage, Mode=OneWay}"
          Message="{x:Bind ViewModel.ControllerMessage, Mode=OneWay}"
          Severity="Warning"
          Title="Controller disconnected" />
      <InfoBar
          IsClosable="True"
          IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
          Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
          Severity="Informational" />
      <!-- SPEC §7.1: resume where you left off -->
      <InfoBar
          CloseButtonCommand="{x:Bind ViewModel.DismissResumeCommand}"
          IsClosable="True"
          IsOpen="{x:Bind ViewModel.HasResumeOffer, Mode=OneWay}"
          Message="Pick up where you stopped last time? Close this to start fresh."
          Severity="Informational"
          Title="Resume">
        <InfoBar.ActionButton>
          <Button AllowFocusOnInteraction="False" Command="{x:Bind ViewModel.ResumeCommand}" Content="Resume" Style="{StaticResource AccentButtonStyle}" />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>

    <controls:GameView x:Name="Game" Grid.Row="2" ZapperEnabled="{x:Bind ViewModel.UsesZapper, Mode=OneWay}" />

    <!-- SPEC §7.9: stat overlay from the game's memory map; drawn over the picture, never into screenshots -->
    <Border
        Grid.Row="2"
        Margin="12"
        Padding="10,6"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#B0000000"
        CornerRadius="6"
        IsHitTestVisible="False"
        Visibility="{x:Bind ViewModel.StatsVisible, Mode=OneWay}">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Stats}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="svc:StatValue">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Foreground="#FFCCCCCC" Text="{x:Bind Label}" />
              <TextBlock FontWeight="SemiBold" Foreground="White" Text="{x:Bind Text}" />
            </StackPanel>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Border>

    <!-- SPEC §7.3 manual fallback: F9 pauses and lets the player type the password -->
    <Border
        Grid.Row="2"
        MaxWidth="420"
        Padding="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.IsEnteringPassword, Mode=OneWay}">
      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Write down the password" />
        <TextBox x:Name="PasswordBox" Header="Password" Text="{x:Bind ViewModel.ManualPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Note (optional)" PlaceholderText="Where you are in the game" Text="{x:Bind ViewModel.ManualPasswordNote, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{x:Bind ViewModel.SaveManualPasswordCommand}" Content="Save" Style="{StaticResource AccentButtonStyle}" />
          <Button Command="{x:Bind ViewModel.CancelManualPasswordCommand}" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- SPEC §7.2: shown while rewinding -->
    <Border
        Grid.Row="2"
        Margin="0,0,0,24"
        Padding="16,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.IsRewinding, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xED3C;" />
        <ProgressBar Width="240" VerticalAlignment="Center" Maximum="60" Value="{x:Bind ViewModel.RewindSeconds, Mode=OneWay}" />
        <TextBlock VerticalAlignment="Center" Text="Rewinding" />
      </StackPanel>
    </Border>

    <ProgressRing
        Grid.Row="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
  </Grid>
</Page>
