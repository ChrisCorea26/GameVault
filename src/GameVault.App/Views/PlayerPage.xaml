<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameVault.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameVault.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:GameVault.App.Helpers"
    xmlns:svc="using:GameVault.ViewModels.Services"
    xmlns:vm="using:GameVault.ViewModels"
    mc:Ignorable="d">

  <Page.KeyboardAccelerators>
    <!-- Esc leaves full screen, otherwise pauses; F11 and Alt+Enter switch full screen (docs/design/input.md §8). -->
    <KeyboardAccelerator Key="Escape" Invoked="Pause_Invoked" />
    <KeyboardAccelerator Key="F11" Invoked="FullScreen_Invoked" />
    <KeyboardAccelerator Key="Enter" Invoked="FullScreen_Invoked" Modifiers="Menu" />
  </Page.KeyboardAccelerators>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top bar (hidden in full screen) -->
    <Grid Grid.Row="0" Padding="12,4" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsWindowed, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- SPEC §7.10: RetroAchievements for the running game, when RetroAchievements recognised it -->
      <Button
          Grid.Column="14"
          AccessKey="E"
          Content="Achievements"
          Visibility="{x:Bind ViewModel.Achievements.HasGame, Mode=OneWay, FallbackValue=Collapsed}">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Opening="AchievementsFlyout_Opening" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="420" Spacing="8">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Achievements.Summary, Mode=OneWay}" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind ViewModel.Achievements.RichPresence, Mode=OneWay}"
                  TextWrapping="Wrap" />
              <ScrollViewer MaxHeight="440">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Achievements.Groups, Mode=OneWay}">
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="svc:AchievementGroup">
                      <StackPanel Margin="0,8,0,0" Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                        <ItemsRepeater ItemsSource="{x:Bind Achievements}">
                          <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="svc:AchievementInfo">
                              <Grid Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnSpacing="12" CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                  <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                  <TextBlock
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Style="{StaticResource CaptionTextBlockStyle}"
                                      Text="{x:Bind Description}"
                                      TextWrapping="Wrap" />
                                  <ProgressBar Margin="0,4,0,0" Maximum="100" Value="{x:Bind MeasuredPercent}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Top" Text="{x:Bind Points}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </ScrollViewer>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Button
          Grid.Column="0"
          AccessKey="B"
          AutomationProperties.Name="Back to library"
          Command="{x:Bind ViewModel.BackCommand}"
          Style="{StaticResource NavigationBackButtonNormalStyle}"
          ToolTipService.ToolTip="Back to library" />
      <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Style="{StaticResource SubtitleTextBlockStyle}"
          Text="{x:Bind ViewModel.Title, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
      <!-- Clicking these leaves keyboard focus on the game, so the controls keep working (input.md §4.4). -->
      <Button
          Grid.Column="3"
          AccessKey="P"
          AllowFocusOnInteraction="False"
          Command="{x:Bind ViewModel.TogglePauseCommand}"
          Content="{x:Bind ViewModel.PauseButtonLabel, Mode=OneWay}" />
      <Button
          Grid.Column="4"
          AccessKey="R"
          AllowFocusOnInteraction="False"
          Command="{x:Bind ViewModel.ResetCommand}"
          Content="Reset" />
      <!-- SPEC §7.8: codes for this game; the badge shows while any are on. F3 turns them all off. -->
      <Button Grid.Column="9" AccessKey="C" AutomationProperties.Name="Codes" Visibility="{x:Bind ViewModel.IsNesGame, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Codes" />
          <Border
              Padding="6,0"
              Background="{ThemeResource AccentFillColorDefaultBrush}"
              CornerRadius="8"
              Visibility="{x:Bind ViewModel.Codes.AnyEnabled, Mode=OneWay}">
            <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="on" />
          </Border>
        </StackPanel>
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <controls:CodesPanel Width="460" ViewModel="{x:Bind ViewModel.Codes}" />
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.7: two-player netplay on the local network (LAN-only for now) -->
      <Button Grid.Column="10" AccessKey="N" Content="Netplay">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="340" Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.Netplay.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Netplay.HasInviteCode, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="28"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Netplay.InviteCode, Mode=OneWay}" />
                <Button HorizontalAlignment="Center" Command="{x:Bind ViewModel.Netplay.CopyCodeCommand}" Content="Copy code" />
              </StackPanel>
              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Netplay.IsIdle, Mode=OneWay}">
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.Netplay.HostCommand}"
                    Content="Host a game on this network"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Or join with the other player's code:" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox
                      AutomationProperties.Name="Invite code"
                      FontFamily="Consolas"
                      PlaceholderText="ABCDE-12345"
                      Text="{x:Bind ViewModel.Netplay.JoinCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Command="{x:Bind ViewModel.Netplay.JoinCommand}" Content="Join" />
                </Grid>
              </StackPanel>
              <Button
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.Netplay.LeaveCommand}"
                  Content="Leave netplay"
                  Visibility="{x:Bind ViewModel.Netplay.IsActive, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.Netplay.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Both games start over from the title screen, without save files or codes. Windows may ask to let GameVault use the network the first time."
                  TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.9: verified challenges; shown when the game has a memory map or a challenge is open. -->
      <Button Grid.Column="13" AccessKey="H" Content="Challenges">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="380" Spacing="12">
              <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Challenges.CanMakeChallenges, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Make a challenge from this moment" />
                <TextBox Header="Name" PlaceholderText="Beat the first boss" Text="{x:Bind ViewModel.Challenges.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <ComboBox
                      HorizontalAlignment="Stretch"
                      Header="Goal"
                      ItemsSource="{x:Bind ViewModel.Challenges.GoalValues, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.Challenges.GoalValueIndex, Mode=TwoWay}" />
                  <ComboBox
                      Grid.Column="1"
                      VerticalAlignment="Bottom"
                      AutomationProperties.Name="Comparison"
                      ItemsSource="{x:Bind ViewModel.Challenges.Ops}"
                      SelectedIndex="{x:Bind ViewModel.Challenges.OpIndex, Mode=TwoWay}" />
                  <TextBox
                      Grid.Column="2"
                      VerticalAlignment="Bottom"
                      AutomationProperties.Name="Goal number"
                      Text="{x:Bind ViewModel.Challenges.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBox
                    Header="Time limit in seconds (optional)"
                    InputScope="Number"
                    Text="{x:Bind ViewModel.Challenges.TimeLimitSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{x:Bind ViewModel.Challenges.MakeCommand}" Content="Save challenge…" Style="{StaticResource AccentButtonStyle}" />
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Take a challenge" />
                <Button Command="{x:Bind ViewModel.Challenges.OpenCommand}" Content="Open challenge…" />
                <TextBlock Text="{x:Bind ViewModel.Challenges.ChallengeSummary, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Challenges.HasChallenge, Mode=OneWay}">
                  <Button Command="{x:Bind ViewModel.Challenges.StartCommand}" Content="Start" />
                  <Button Command="{x:Bind ViewModel.Challenges.GiveUpCommand}" Content="Give up" />
                  <Button Command="{x:Bind ViewModel.Challenges.SaveResultCommand}" Content="Save result…" />
                  <Button Command="{x:Bind ViewModel.Challenges.CheckResultCommand}" Content="Check a result…" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.Challenges.Message, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <ToggleButton
          Grid.Column="12"
          AccessKey="T"
          AllowFocusOnInteraction="False"
          Content="Stats"
          IsChecked="{x:Bind ViewModel.ShowStats, Mode=TwoWay}"
          ToolTipService.ToolTip="Show values from the game, such as exact health"
          Visibility="{x:Bind ViewModel.HasMemoryMap, Mode=OneWay}" />
      <Button
          Grid.Column="11"
          AccessKey="F"
          AllowFocusOnInteraction="False"
          AutomationProperties.Name="{x:Bind ViewModel.FullScreenButtonLabel, Mode=OneWay}"
          Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
          ToolTipService.ToolTip="Full screen (F11 or Alt+Enter; Esc to leave)">
        <FontIcon FontSize="16" Glyph="&#xE740;" />
      </Button>

      <!-- Famicom Disk System: the side in the drive; F4 inserts the next side (input.md §8) -->
      <ComboBox
          Grid.Column="8"
          MinWidth="170"
          VerticalAlignment="Center"
          AutomationProperties.Name="Disk side"
          DropDownClosed="DiskSide_DropDownClosed"
          ItemsSource="{x:Bind ViewModel.DiskSlots}"
          SelectedIndex="{x:Bind ViewModel.DiskSlotIndex, Mode=TwoWay}"
          ToolTipService.ToolTip="Disk side (F4: next side)"
          Visibility="{x:Bind ViewModel.IsDiskSystem, Mode=OneWay}" />
      <!-- SPEC §7.1: the save-state timeline; F5 saves, F8 loads the newest (docs/design/input.md §8). -->
      <Button Grid.Column="5" AccessKey="S" Content="Save states">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="620" Spacing="8">
              <Grid>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save states" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.Timeline.SaveCommand}" Content="Save now" Style="{StaticResource AccentButtonStyle}" />
              </Grid>
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="F5 saves and F8 loads the newest. Right-click a state to pin or delete it." />
              <controls:TimelineStrip ItemTemplate="{StaticResource TimelineItemTemplate}" ItemsSource="{x:Bind ViewModel.Timeline.Items}" />
              <InfoBar
                  IsClosable="True"
                  IsOpen="{x:Bind ViewModel.Timeline.HasUndo, Mode=OneWay}"
                  Message="{x:Bind ViewModel.Timeline.UndoText, Mode=OneWay}"
                  Severity="Informational">
                <InfoBar.ActionButton>
                  <Button Command="{x:Bind ViewModel.Timeline.UndoCommand}" Content="Undo" />
                </InfoBar.ActionButton>
              </InfoBar>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.6: Assist mode, per session, never forced -->
      <Button Grid.Column="6" AccessKey="A" Content="Assist">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="300" Spacing="8">
              <ToggleSwitch Header="Assist mode" IsOn="{x:Bind ViewModel.Assist.IsEnabled, Mode=TwoWay}" />
              <ComboBox
                  Header="Speed"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Assist.SpeedOptions}"
                  SelectedIndex="{x:Bind ViewModel.Assist.SpeedIndex, Mode=TwoWay}" />
              <ComboBox
                  Header="Colors"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}"
                  ItemsSource="{x:Bind ViewModel.Assist.PaletteOptions}"
                  SelectedIndex="{x:Bind ViewModel.Assist.PaletteIndex, Mode=TwoWay}" />
              <CheckBox Content="Unlimited rewind" IsChecked="{x:Bind ViewModel.Assist.UnlimitedRewind, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}" />
              <CheckBox Content="Reduce flicker" IsChecked="{x:Bind ViewModel.Assist.RemoveFlicker, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Assist.IsEnabled, Mode=OneWay}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- SPEC §7.6: Practice mode -->
      <Button Grid.Column="7" Content="Practice">
        <Button.Flyout>
          <Flyout Closed="Flyout_Closed" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="300" Spacing="8">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Practice" />
              <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="Set a practice point, then press F6 to retry from it and F7 to mark a split."
                  TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.Practice.SetPointCommand}" Content="Set practice point" />
                <Button Command="{x:Bind ViewModel.Practice.RetryCommand}" Content="Retry" />
                <Button Command="{x:Bind ViewModel.Practice.SplitCommand}" Content="Split" />
              </StackPanel>
              <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Practice.CurrentTime, Mode=OneWay}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Practice.BestForCurrent, Mode=OneWay}" />
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.Practice.Segments}">
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="vm:SegmentViewModel">
                    <Grid Padding="0,2" ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Title}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Time}" />
                      <TextBlock Grid.Column="2" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind Badge}" />
                    </Grid>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="12,0,12,0" Spacing="8">
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
          Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
          Severity="Error"
          Title="Can't play this game" />
      <!-- docs/design/input.md §5 -->
      <InfoBar
          IsClosable="False"
          IsOpen="{x:Bind ViewModel.HasControllerMessage, Mode=OneWay}"
          Message="{x:Bind ViewModel.ControllerMessage, Mode=OneWay}"
          Severity="Warning"
          Title="Controller disconnected" />
      <InfoBar
          IsClosable="True"
          IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
          Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
          Severity="Informational" />
      <!-- SPEC §7.1: resume where you left off -->
      <InfoBar
          CloseButtonCommand="{x:Bind ViewModel.DismissResumeCommand}"
          IsClosable="True"
          IsOpen="{x:Bind ViewModel.HasResumeOffer, Mode=OneWay}"
          Message="Pick up where you stopped last time? Close this to start fresh."
          Severity="Informational"
          Title="Resume">
        <InfoBar.ActionButton>
          <Button AllowFocusOnInteraction="False" Command="{x:Bind ViewModel.ResumeCommand}" Content="Resume" Style="{StaticResource AccentButtonStyle}" />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>

    <controls:GameView x:Name="Game" Grid.Row="2" ZapperEnabled="{x:Bind ViewModel.UsesZapper, Mode=OneWay}" />

    <!-- SPEC §7.9: "Previously on…" after a break of a day or more -->
    <Border
        Grid.Row="2"
        MaxWidth="560"
        Margin="24"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.Recap.IsVisible, Mode=OneWay}">
      <StackPanel Spacing="10">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Recap.Heading, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Recap.LastSession, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Height="120" Visibility="{x:Bind ViewModel.Recap.HasScreenshot, Mode=OneWay}">
            <Image.Source>
              <BitmapImage DecodePixelHeight="240" UriSource="{x:Bind ViewModel.Recap.ScreenshotUri, Mode=OneWay}" />
            </Image.Source>
          </Image>
          <Image Height="120" Visibility="{x:Bind ViewModel.Recap.HasMap, Mode=OneWay}">
            <Image.Source>
              <BitmapImage DecodePixelHeight="240" UriSource="{x:Bind ViewModel.Recap.MapUri, Mode=OneWay}" />
            </Image.Source>
          </Image>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Recap.Note, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock FontFamily="Consolas" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Recap.Password, Mode=OneWay}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
          <Button
              Command="{x:Bind ViewModel.ResumeCommand}"
              Content="Resume where I left off"
              Visibility="{x:Bind ViewModel.HasResumeOffer, Mode=OneWay}" />
          <Button Command="{x:Bind ViewModel.Recap.DismissCommand}" Content="Continue" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- SPEC §7.10: RetroAchievements trackers and challenge badges (top right), and the notification card -->
    <StackPanel
        Grid.Row="2"
        Margin="12"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        IsHitTestVisible="False"
        Spacing="6">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Achievements.Trackers, Mode=OneWay}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:TrackerItem">
            <Border Margin="0,0,0,4" Padding="10,4" HorizontalAlignment="Right" Background="#B0000000" CornerRadius="6">
              <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Foreground="White" Text="{x:Bind Text, Mode=OneWay}" />
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Achievements.Challenges, Mode=OneWay}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="svc:AchievementInfo">
            <Border Margin="0,0,0,4" Padding="8,4" HorizontalAlignment="Right" Background="#B0000000" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Foreground="Gold" Glyph="&#xE734;" />
                <TextBlock Foreground="White" Text="{x:Bind Title}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
    <Border
        Grid.Row="2"
        MaxWidth="420"
        Margin="16"
        Padding="14"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.Achievements.HasNotification, Mode=OneWay, FallbackValue=Collapsed}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Width="56" Height="56" Visibility="{x:Bind ViewModel.Achievements.HasNotificationBadge, Mode=OneWay, FallbackValue=Collapsed}">
          <Image.Source>
            <BitmapImage DecodePixelHeight="112" UriSource="{x:Bind ViewModel.Achievements.NotificationBadgeUri, Mode=OneWay}" />
          </Image.Source>
        </Image>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Achievements.NotificationHeading, Mode=OneWay}" />
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Achievements.NotificationTitle, Mode=OneWay}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Achievements.NotificationText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- SPEC §7.9: the family profile's daily limit — a warning, then a stop that needs the parent PIN -->
    <InfoBar
        Grid.Row="2"
        Margin="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        IsClosable="True"
        IsOpen="{x:Bind ViewModel.Limit.HasWarning, Mode=OneWay}"
        Message="{x:Bind ViewModel.Limit.Warning, Mode=OneWay}"
        Severity="Warning" />
    <Border
        Grid.Row="2"
        MaxWidth="480"
        Margin="24"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.Limit.IsLimitReached, Mode=OneWay}">
      <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Time's up for today" />
        <TextBlock Text="{x:Bind ViewModel.Limit.LimitMessage, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PasswordBox
              Width="160"
              AutomationProperties.Name="Parent PIN"
              InputScope="NumericPin"
              Password="{x:Bind ViewModel.Limit.PinEntry, Mode=TwoWay}"
              PlaceholderText="Parent PIN" />
          <Button Command="{x:Bind ViewModel.Limit.ContinueCommand}" Content="Keep playing" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ViewModel.Limit.PinMessage, Mode=OneWay}" />
      </StackPanel>
    </Border>

    <!-- SPEC §7.9: stat overlay from the game's memory map; drawn over the picture, never into screenshots -->
    <Border
        Grid.Row="2"
        Margin="12"
        Padding="10,6"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#B0000000"
        CornerRadius="6"
        IsHitTestVisible="False"
        Visibility="{x:Bind ViewModel.StatsVisible, Mode=OneWay}">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Stats}">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="svc:StatValue">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Foreground="#FFCCCCCC" Text="{x:Bind Label}" />
              <TextBlock FontWeight="SemiBold" Foreground="White" Text="{x:Bind Text}" />
            </StackPanel>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </Border>

    <!-- SPEC §7.3 manual fallback: F9 pauses and lets the player type the password -->
    <Border
        Grid.Row="2"
        MaxWidth="420"
        Padding="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.IsEnteringPassword, Mode=OneWay}">
      <StackPanel Spacing="8">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Write down the password" />
        <TextBox x:Name="PasswordBox" Header="Password" Text="{x:Bind ViewModel.ManualPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Note (optional)" PlaceholderText="Where you are in the game" Text="{x:Bind ViewModel.ManualPasswordNote, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{x:Bind ViewModel.SaveManualPasswordCommand}" Content="Save" Style="{StaticResource AccentButtonStyle}" />
          <Button Command="{x:Bind ViewModel.CancelManualPasswordCommand}" Content="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- SPEC §7.2: shown while rewinding -->
    <Border
        Grid.Row="2"
        Margin="0,0,0,24"
        Padding="16,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.IsRewinding, Mode=OneWay}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <FontIcon Glyph="&#xED3C;" />
        <ProgressBar Width="240" VerticalAlignment="Center" Maximum="60" Value="{x:Bind ViewModel.RewindSeconds, Mode=OneWay}" />
        <TextBlock VerticalAlignment="Center" Text="Rewinding" />
      </StackPanel>
    </Border>

    <ProgressRing
        Grid.Row="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
  </Grid>
</Page>
