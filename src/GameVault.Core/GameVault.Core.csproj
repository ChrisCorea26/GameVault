<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The emulation core. Must stay deterministic and platform-independent:
    no references to UI, file I/O, threading, timers or platform libraries (CLAUDE.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GameVault.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameVault.Core.Tests" />
  </ItemGroup>

</Project>
