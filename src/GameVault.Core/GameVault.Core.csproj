<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The emulation core. Must stay deterministic and platform-independent:
    no references to UI, file I/O, threading, timers or platform libraries (CLAUDE.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GameVault.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The emulation cores are compiled optimized in Debug builds too: unoptimized, the PlayStation runs at a third of
         full speed and later systems slower still (docs/bugs.md GV-025). Debug symbols stay, so the app can still be
         debugged; stepping through the core may skip lines. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameVault.Core.Tests" />
    <InternalsVisibleTo Include="GameVault.Platform" />
    <InternalsVisibleTo Include="GameVault.Platform.Tests" />
  </ItemGroup>

</Project>
