<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows platform services: audio (NAudio), video sinks, SDL input, timing, storage. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GameVault.Platform</RootNamespace>
    <!-- Lets the library build on Linux/macOS (CI and cloud sessions); it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- SDL interop (Silk.NET) uses pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Silk.NET.SDL" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Video\Shaders\Display.hlsl" LogicalName="GameVault.Display.hlsl" />
    <EmbeddedResource Include="Video\Shaders\PsGpu.hlsl" LogicalName="GameVault.PsGpu.hlsl" />
    <EmbeddedResource Include="Video\Shaders\N64Rdp.hlsl" LogicalName="GameVault.N64Rdp.hlsl" />
  </ItemGroup>

  <!--
    RetroAchievements (Phase 10): the vendored rcheevos C library in native/ is built with CMake when the
    library for this machine is missing, then copied next to the assemblies (and to every project that
    references this one). Without CMake or a C compiler the build carries on; achievements are then off.
  -->
  <PropertyGroup>
    <RcheevosRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'native'))</RcheevosRoot>
    <RcheevosArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RcheevosArch>
    <RcheevosRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(RcheevosArch)</RcheevosRid>
    <RcheevosRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(RcheevosArch)</RcheevosRid>
    <RcheevosRid Condition="'$(RcheevosRid)' == ''">linux-$(RcheevosArch)</RcheevosRid>
    <RcheevosFileName Condition="$([MSBuild]::IsOSPlatform('Windows'))">rcheevos.dll</RcheevosFileName>
    <RcheevosFileName Condition="$([MSBuild]::IsOSPlatform('OSX'))">librcheevos.dylib</RcheevosFileName>
    <RcheevosFileName Condition="'$(RcheevosFileName)' == ''">librcheevos.so</RcheevosFileName>
    <RcheevosOut>$(RcheevosRoot)out$([System.IO.Path]::DirectorySeparatorChar)$(RcheevosRid)</RcheevosOut>
    <RcheevosLibrary>$(RcheevosOut)$([System.IO.Path]::DirectorySeparatorChar)$(RcheevosFileName)</RcheevosLibrary>
  </PropertyGroup>

  <Target Name="BuildRcheevos" Condition="!Exists('$(RcheevosLibrary)')">
    <Exec Command="cmake -S &quot;$(RcheevosRoot).&quot; -B &quot;$(RcheevosRoot)build$([System.IO.Path]::DirectorySeparatorChar)$(RcheevosRid)&quot; -DCMAKE_BUILD_TYPE=Release -DGV_OUT=&quot;$(RcheevosOut)&quot;" ContinueOnError="true" StandardOutputImportance="low" />
    <Exec Command="cmake --build &quot;$(RcheevosRoot)build$([System.IO.Path]::DirectorySeparatorChar)$(RcheevosRid)&quot; --config Release" ContinueOnError="true" StandardOutputImportance="low" />
    <Warning Condition="!Exists('$(RcheevosLibrary)')" Text="rcheevos could not be built (CMake and a C compiler are needed); RetroAchievements will be unavailable. See docs/plans/phase-10.md." />
  </Target>

  <Target Name="AddRcheevosToOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildRcheevos">
    <ItemGroup>
      <None Include="$(RcheevosLibrary)" Condition="Exists('$(RcheevosLibrary)')" Link="$(RcheevosFileName)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="GameVault.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
    <ProjectReference Include="..\GameVault.Dumper\GameVault.Dumper.csproj" />
    <!-- Only for the service interfaces it implements (see docs/plans/phase-0.md). -->
    <ProjectReference Include="..\GameVault.ViewModels\GameVault.ViewModels.csproj" />
    <ProjectReference Include="..\GameVault.Relay\GameVault.Relay.csproj" />
  </ItemGroup>

</Project>
